DATABASE_URL="postgresql://usuario:senha@host:5432/audio_novel?sslmode=require"
# Opcional: sobrescreve connection_limit da DATABASE_URL. Sem ambos, o padrao e 3.
PRISMA_CONNECTION_LIMIT="3"
NEXTAUTH_SECRET="gere-um-segredo-aleatorio-longo"
APP_ORIGIN="https://audionovelbr.com.br"

# Opcional: use um segredo separado para os buckets de rate limit.
RATE_LIMIT_SECRET=""

# Defina somente quando o proxy remover valores enviados pelo cliente e
# preencher este cabeçalho com o IP verificado.
TRUSTED_PROXY_IP_HEADER="x-real-ip"

MEDIA_URL_ALLOWED_HOSTS=""
IMAGE_URL_ALLOWED_HOSTS=""

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

AGENTMAIL_API_KEY=""
AGENTMAIL_INBOX_ID=""

# Apenas para `npm run prisma:seed` em ambiente controlado.
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
